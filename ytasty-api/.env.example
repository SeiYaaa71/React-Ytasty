# Utilise uniquement hors Docker. En Docker, docker-compose.yml impose sa
# propre valeur, avec "db" comme host. Laisser vide ici fait tourner l'API
# sur un fichier SQLite local.
DATABASE_URL=

# --- Securite ---
# Doit faire au moins 32 caracteres. Generer avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=c3CJCkBKNKUuZalf7llxUtONdXUVZcu0HvSzENVdm_VCzTRm0CCav9oMUcIMF4YVR
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
