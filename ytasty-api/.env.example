# --- Base de donnees ---
POSTGRES_USER=ytasty
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ytasty

# Docker : le host est le service "db" du docker-compose
DATABASE_URL=postgresql+psycopg://ytasty:change_me@db:5432/ytasty
# Local sans Docker : laisser vide, l'API utilise alors un fichier SQLite

# --- Securite ---
JWT_SECRET_KEY=change_me_with_a_long_random_secret_of_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Origines autorisees a appeler l'API depuis un navigateur, separees par des virgules
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
